# Konfigurasi Supabase (dapatkan dari Dashboard Supabase > Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret untuk session JWT (minimal 32 karakter acak)
SESSION_SECRET=

# Kunci Enkripsi AES-256-GCM (WAJIB 64 karakter heksadesimal = 32 byte)
# Digunakan untuk mengenkripsi secret Google Drive Bridge tiap cabang di database.
# JANGAN GANTI setelah aplikasi dipakai, simpan cadangannya di tempat aman!
ENCRYPTION_KEY=
